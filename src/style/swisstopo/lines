# -------------------------------------------------------------------
# Helvetopo – Linien (mkgmap-Style "swisstopo")
# Vorbild: Swiss Map Vector 25 (SMV25), Farben siehe docs/stil/stil.md
#
# Eingabe: Standard-OSM-Tags plus swisstopo:*-Zusatztags nach docs/daten/tag-schema.md
# (Konverter src/vector/). Für die Darstellung zählen vor allem:
#   swisstopo:objektart            TLM-Objektart im Originalwortlaut, z. B. '6m Strasse', '1m Weg'
#   swisstopo:verkehrsbedeutung    'Hochleistungsstrasse' | 'Durchgangsstrasse' | 'Verbindungsstrasse'
#   swisstopo:belagsart            'Hart' | 'Natur'
#   swisstopo:untergrund           bei Höhenkurven: 'fels' | 'gletscher' | 'see' (Annahme, Overlay 7703)
# highway=* bestimmt Routing-Klasse und Geschwindigkeit, nicht die Signatur.
#
# Typcodes: 0x01–0x13, 0x16, 0x1a, 0x1b sind routingfähig (road_class/road_speed),
# alle anderen Linien sind reine Darstellung.
# -------------------------------------------------------------------

# Strassenname für Adresssuche und Hausnummern
# Adresspunkte ohne eigenes Symbol trotzdem durch die Finalize-Regeln schicken (Hausnummernsuche)
addr:housenumber=* { set mkgmap:execute_finalize_rules=true }

highway=* & name=* { set mkgmap:street='${name}' }

# Geplante oder abgebrochene Wege nicht zeigen
highway=proposed | highway=planned | highway=abandoned | highway=razed | highway=dismantled { delete highway }
highway=construction { set tmp:inbau=yes }

include 'inc/access';

# ------------------------------------------------------------------
# 1. Routing-Klasse und Geschwindigkeit aus dem Strassentyp (nicht aus der Breite)
#    road_class 4..0, road_speed 7..0 (siehe Style-Manual 4.6.4/4.6.5)
# ------------------------------------------------------------------
highway=motorway                       { set mkgmap:road-class=4; set mkgmap:road-speed-class=7 }
highway=motorway_link                  { set mkgmap:road-class=4; set mkgmap:road-speed-class=4 }
highway=trunk                          { set mkgmap:road-class=4; set mkgmap:road-speed-class=6 }
highway=trunk_link                     { set mkgmap:road-class=3; set mkgmap:road-speed-class=4 }
highway=primary                        { set mkgmap:road-class=3; set mkgmap:road-speed-class=5 }
highway=primary_link                   { set mkgmap:road-class=3; set mkgmap:road-speed-class=3 }
highway=secondary                      { set mkgmap:road-class=2; set mkgmap:road-speed-class=4 }
highway=secondary_link                 { set mkgmap:road-class=2; set mkgmap:road-speed-class=3 }
highway=tertiary | highway=tertiary_link { set mkgmap:road-class=1; set mkgmap:road-speed-class=3 }
highway=unclassified                   { set mkgmap:road-class=0; set mkgmap:road-speed-class=3 }
highway=residential                    { set mkgmap:road-class=0; set mkgmap:road-speed-class=2 }
highway=living_street                  { set mkgmap:road-class=0; set mkgmap:road-speed-class=1 }
highway=service                        { set mkgmap:road-class=0; set mkgmap:road-speed-class=1 }
highway=track                          { set mkgmap:road-class=0; set mkgmap:road-speed-class=1 }
highway=pedestrian | highway=cycleway  { set mkgmap:road-class=0; set mkgmap:road-speed-class=1 }
highway=path | highway=footway | highway=bridleway | highway=steps | highway=via_ferrata
                                       { set mkgmap:road-class=0; set mkgmap:road-speed-class=0 }

# Routing-Präferenz Wanderwege/Veloland (nur autofreie Kanten; Schalter --style-option=routing_pref=…)
include 'inc/routing_pref';

# ------------------------------------------------------------------
# 2. Darstellungsklasse tmp:look (bestimmt den Typcode / die TYP-Signatur)
# ------------------------------------------------------------------
# Farbige Strassen (SMV: Autobahn/Autostrasse orange, Durchgangsstrasse rot, Verbindungsstrasse gelb)
swisstopo:objektart=Autobahn                                    { set tmp:look=autobahn }
swisstopo:objektart=Autostrasse                                 { set tmp:look=autostrasse }
swisstopo:objektart~'Ausfahrt|Einfahrt|Zufahrt|Raststaette'     { set tmp:look=rampe }
swisstopo:objektart=Verbindung & highway=motorway               { set tmp:look=autobahn }
swisstopo:objektart=Verbindung & highway=trunk & motorroad=yes  { set tmp:look=autostrasse }
tmp:look!=* & swisstopo:verkehrsbedeutung=Hochleistungsstrasse & highway~'motorway.*|trunk.*' { set tmp:look=rampe }
tmp:look!=* & swisstopo:verkehrsbedeutung=Durchgangsstrasse & swisstopo:objektart!='2m Weg' { set tmp:look=durchgang }
tmp:look!=* & swisstopo:verkehrsbedeutung=Verbindungsstrasse & swisstopo:objektart!='2m Weg' { set tmp:look=verbindung }

# Rückfall für Daten ohne swisstopo:*-Tags (reine OSM-Daten)
tmp:look!=* & swisstopo:objektart!=* & highway=motorway                          { set tmp:look=autobahn }
tmp:look!=* & swisstopo:objektart!=* & highway=trunk                             { set tmp:look=autostrasse }
tmp:look!=* & swisstopo:objektart!=* & highway~'motorway_link|trunk_link'        { set tmp:look=rampe }
tmp:look!=* & swisstopo:objektart!=* & highway~'primary|primary_link'            { set tmp:look=durchgang }
tmp:look!=* & swisstopo:objektart!=* & highway~'secondary|secondary_link'        { set tmp:look=verbindung }

# Weisse Strassen und Wege: Breitenklasse aus der TLM-Objektart
tmp:look!=* & swisstopo:objektart~'(10m|8m|6m) Strasse'  { set tmp:look=w6 }
tmp:look!=* & swisstopo:objektart='4m Strasse'           { set tmp:look=w4 }
tmp:look!=* & swisstopo:objektart='3m Strasse'           { set tmp:look=w3 }
tmp:look!=* & swisstopo:objektart='2m Weg'               { set tmp:look=weg2 }
tmp:look!=* & swisstopo:objektart='1m Weg'               { set tmp:look=weg1 }
tmp:look!=* & swisstopo:objektart~'.*Wegfragment|Markierte Spur' { set tmp:look=spur }
tmp:look!=* & swisstopo:objektart~'Platz|Dienstzufahrt'  { set tmp:look=w3 }
# Verbindung (kurze Netz-Verbinder): erbt highway, Signatur unten aus dem Rückfall

# Rückfall ohne Breitenklasse: aus OSM-Tags ableiten
tmp:look!=* & (highway=tertiary | highway=tertiary_link)               { set tmp:look=w6 }
tmp:look!=* & (highway=unclassified | highway=residential | highway=living_street) { set tmp:look=w4 }
tmp:look!=* & (highway=service | highway=pedestrian)                   { set tmp:look=w3 }
tmp:look!=* & highway=track & (tracktype=grade4 | tracktype=grade5)   { set tmp:look=weg2 }
tmp:look!=* & highway=track                                           { set tmp:look=w3 }
tmp:look!=* & highway=cycleway                                        { set tmp:look=weg2 }
tmp:look!=* & (highway=path | highway=footway | highway=bridleway) & trail_visibility~'bad|horrible|no' { set tmp:look=spur }
tmp:look!=* & (highway=path | highway=footway | highway=bridleway)    { set tmp:look=weg1 }
tmp:look!=* & highway~'motorway.*|trunk.*'                            { set tmp:look=rampe }
tmp:look!=* & highway~'primary.*|secondary.*'                         { set tmp:look=w6 }

# Belag: Naturbelag macht aus weissen Strassen den "Fahrweg" (weiss, punktierte Ränder)
(swisstopo:belagsart=Natur | surface~'unpaved|gravel|fine_gravel|compacted|dirt|ground|grass|earth|mud|sand' |
 tracktype~'grade[2-5]') & highway=* { set mkgmap:unpaved=1; set tmp:natur=yes }
# Routing-Präferenz A6 (docs/vektor/routing.md): Veloland ist mit dem Tourenvelo befahrbar, auch auf
# Naturbelag. Ohne Unpaved-Flag bleibt die Route dort, wenn das Velo-Profil „unbefestigt vermeiden“
# aktiv hat (BaseCamp-Standard). Die Signatur (tmp:natur, Fahrweg) bleibt unverändert.
mkgmap:option:routing_pref!=off & route_bicycle=* & mkgmap:unpaved=1 { delete mkgmap:unpaved }
tmp:natur=yes & tmp:look~'w[346]'  { set tmp:look=fahrweg }
# 2m Weg: mit Hartbelag als schmale Strasse, sonst schwarzer Strich
tmp:look=weg2 & (swisstopo:belagsart=Hart | surface~'asphalt|paved|concrete.*|paving_stones|sett') { set tmp:look=w2 }
highway=cycleway & tmp:natur!=yes & tmp:look=weg2 { set tmp:look=w2 }
# 2m Weg nicht befahrbar (SMV gestrichelt 3,0/0,3 mm)
tmp:look=weg2 & swisstopo:befahrbarkeit=Falsch { set tmp:look=weg2n }
# Treppen und Klettersteige haben eigene Signaturen, unabhängig von der Breite
highway=steps { set tmp:look=treppe }
highway=via_ferrata | via_ferrata=yes | swisstopo:verkehrsbeschraenkung='Gesicherte Kletterpartie' { set tmp:look=klettersteig }

# ------------------------------------------------------------------
# 3. Fähren (routingfähig)
# ------------------------------------------------------------------
route=ferry & (motorcar=yes | motor_vehicle=yes | swisstopo:objektart=Autofaehre | swisstopo:objektart='Autofähre')
    { set mkgmap:ferry=1; name '${name}' } [0x1a road_class=1 road_speed=1 resolution 20]
route=ferry
    { set mkgmap:ferry=1; set mkgmap:car=no; name '${name}' } [0x1b road_class=0 road_speed=0 resolution 22]

# ------------------------------------------------------------------
# 4. Strassen und Wege (routingfähig)
# ------------------------------------------------------------------
# Etappe 8: Jede Strasse zweimal.
#  - Auflösung 24: Routingtyp (0x01–0x16), LK-Geländebreite, Strassennamen.
#  - Auflösung <= 23: Übersichtstyp 0x10a00|Typ, nicht routingfähig, LK-Strichbreite am Gerät,
#    nur Routennummern (LK beschriftet Strassen fast nur mit Nummern). Routing und Adresssuche
#    laufen auf den Daten der Auflösung 24.
# Grobstufen LK100/LK200 (Auflösung 12–20, Etappe 26): eigene Typen 0x10900|Typ, auch für Tunnel
# (vorher Lücken, z. B. A9 im Wallis); Routennummern nur an Autobahn und Autostrasse, und erst ab 18
# (Etappe 27). Durchgangs- und Verbindungsstrassen auch in 21 ohne Nummer (Platz für Stadtnamen).
# Review 1: Shields aus vector-convert (swisstopo:shield_autobahn „A1“, swisstopo:shield_hauptstrasse „7“,
# nur signalisierte Hauptstrassen; B/C-Nummern aus ref erhalten keinen Shield). Autobahn und
# Autostrasse box (Gerätetest Review 1: S5), Hauptstrasse hbox (S4), dreistellig round (S3); die Routen nutzen oval. ref nur noch als Rückfall für alte PBF.
# Review 3 (Benutzer): dreistellige Hauptstrassen (z. B. 447) mit rundem Schild (S3, round), ein- und
# zweistellige weiter hbox (S4). Die dreistelligen Nummern der Hauptstrassen B/C liefert vector-convert
# als swisstopo:hauptstrasse_nr_intern (nicht signalisiert). Die signalisierte Nummer hat Vorrang.
# tmp:hs_sym trägt die Nummer samt Schild-Präfix.
swisstopo:shield_hauptstrasse=* { set tmp:hs='${swisstopo:shield_hauptstrasse|part:;:1}' }
tmp:hs!=* & swisstopo:hauptstrasse_nr_intern=* { set tmp:hs='${swisstopo:hauptstrasse_nr_intern|part:;:1}' }
tmp:hs~'[0-9]{3}'                { set tmp:hs_sym='${tmp:hs|highway-symbol:round}' }
tmp:hs=* & tmp:hs_sym!=*         { set tmp:hs_sym='${tmp:hs|highway-symbol:hbox}' }
# Nummern erst ab 19 und bis 21 nicht in der Nähe einer Stadt (swisstopo:stadtabstand: Meter bis zum
# nächsten Stadtpunkt ab 10 000 Einwohnern, 0x1150d ab 18). Grenze je Stufe wie die Breite des
# Stadtnamens am Gerät: 18 4 km, 19 3 km, 20 2 km, 21 1,5 km. Das GPSMAP 67 setzt Schilder und
# Flussnamen vor die Ortsnamen: Bei 3 km stand ein A1-Schild an der Stelle von „St. Gallen“, bei 8 km
# fehlten St. Gallen, Rorschach und Herisau (Gerätetest 7794-klassen2).
tmp:look=autobahn    { delete mkgmap:label:1 } [0x10905 resolution 12-18 continue]
tmp:look=autobahn & swisstopo:stadtabstand<3000 { delete mkgmap:label:1 } [0x10901 resolution 19-19 continue]
tmp:look=autobahn & (swisstopo:stadtabstand!=* | swisstopo:stadtabstand>=3000) { delete mkgmap:label:1; name '${swisstopo:shield_autobahn|highway-symbol:box}' | '${ref|highway-symbol:box}' } [0x10901 resolution 19-19 continue]
tmp:look=autobahn & swisstopo:stadtabstand<2000 { delete mkgmap:label:1 } [0x10901 resolution 20-20 continue]
tmp:look=autobahn & (swisstopo:stadtabstand!=* | swisstopo:stadtabstand>=2000) { delete mkgmap:label:1; name '${swisstopo:shield_autobahn|highway-symbol:box}' | '${ref|highway-symbol:box}' } [0x10901 resolution 20-20 continue]
tmp:look=autostrasse { delete mkgmap:label:1 } [0x10906 resolution 14-18 continue]
tmp:look=autostrasse & swisstopo:stadtabstand<3000 { delete mkgmap:label:1 } [0x10902 resolution 19-19 continue]
tmp:look=autostrasse & (swisstopo:stadtabstand!=* | swisstopo:stadtabstand>=3000) { delete mkgmap:label:1; name '${swisstopo:shield_autobahn|highway-symbol:box}' | '${tmp:hs_sym}' } [0x10902 resolution 19-19 continue]
tmp:look=autostrasse & swisstopo:stadtabstand<2000 { delete mkgmap:label:1 } [0x10902 resolution 20-20 continue]
tmp:look=autostrasse & (swisstopo:stadtabstand!=* | swisstopo:stadtabstand>=2000) { delete mkgmap:label:1; name '${swisstopo:shield_autobahn|highway-symbol:box}' | '${tmp:hs_sym}' } [0x10902 resolution 20-20 continue]
tmp:look=durchgang   { delete mkgmap:label:1 } [0x10903 resolution 16-21 continue]
tmp:look=verbindung  { delete mkgmap:label:1 } [0x10904 resolution 18-21 continue]
# Review 2 (Übersicht zu leer, Mass SMR200): übrige Kantonsstrassen in 19–20 als feine Doppellinie (LK200).
# Nicht nach Breite (6 m wechselt abschnittweise mit 4 m → Stücke ohne Anschluss), sondern nach
# Eigentümer: Kantonsstrassen ohne Verkehrsbedeutung bilden das zusammenhängende Netz zwischen den Dörfern.
(tmp:look=w6 | tmp:look=w4) & swisstopo:netz_res!=* & swisstopo:eigentuemer=Kanton & swisstopo:verkehrsbedeutung!=*
                     { delete mkgmap:label:1 } [0x10907 resolution 19-20 continue]

# Strassentunnel (alle Klassen): gestrichelte Signatur, Routing bleibt
highway=* & tmp:look~'autobahn|autostrasse|rampe|durchgang|verbindung|w6|w4|w3|w2|fahrweg' & (tunnel=yes | tunnel=building_passage | tunnel=covered)
    { name '${name}' | '${swisstopo:shield_autobahn}' | '${swisstopo:shield_hauptstrasse|part:;:1}' } [0x13 road_class=0 road_speed=1 resolution 24 continue]
# Review 2: Tunnel kleiner Klassen erst ab ihrer Netzstufe (swisstopo:netz_res), sonst isolierte Stücke in 21.
highway=* & tmp:look~'w6|w4|w3|w2|fahrweg' & (tunnel=yes | tunnel=building_passage | tunnel=covered) & swisstopo:netz_res=23
    { delete mkgmap:label:1; name '${swisstopo:shield_autobahn}' | '${swisstopo:shield_hauptstrasse|part:;:1}' } [0x10a13 resolution 23-23]
highway=* & tmp:look~'w6|w4|w3|w2|fahrweg' & (tunnel=yes | tunnel=building_passage | tunnel=covered) & swisstopo:netz_res=22
    { delete mkgmap:label:1; name '${swisstopo:shield_autobahn}' | '${swisstopo:shield_hauptstrasse|part:;:1}' } [0x10a13 resolution 22-23]
highway=* & tmp:look~'autobahn|autostrasse|rampe|durchgang|verbindung|w6|w4|w3|w2|fahrweg' & (tunnel=yes | tunnel=building_passage | tunnel=covered)
    { delete mkgmap:label:1; name '${swisstopo:shield_autobahn}' | '${swisstopo:shield_hauptstrasse|part:;:1}' } [0x10a13 resolution 21-23]

tmp:look=autobahn { name '${swisstopo:shield_autobahn|highway-symbol:box}' | '${ref|highway-symbol:box}' | '${name}' } [0x01 road_class=4 road_speed=7 resolution 24 continue]
tmp:look=autobahn & swisstopo:stadtabstand<1500 { delete mkgmap:label:1 } [0x10a01 resolution 21-21 continue]
tmp:look=autobahn & (swisstopo:stadtabstand!=* | swisstopo:stadtabstand>=1500) { delete mkgmap:label:1; name '${swisstopo:shield_autobahn|highway-symbol:box}' | '${ref|highway-symbol:box}' } [0x10a01 resolution 21-21 continue]
tmp:look=autobahn { delete mkgmap:label:1; name '${swisstopo:shield_autobahn|highway-symbol:box}' | '${ref|highway-symbol:box}' } [0x10a01 resolution 22-23]
tmp:look=autostrasse { name '${swisstopo:shield_autobahn|highway-symbol:box} ${name}' | '${tmp:hs_sym} ${name}' | '${swisstopo:shield_autobahn|highway-symbol:box}' | '${tmp:hs_sym}' | '${name}' } [0x02 road_class=4 road_speed=6 resolution 24 continue]
tmp:look=autostrasse & swisstopo:stadtabstand<1500 { delete mkgmap:label:1 } [0x10a02 resolution 21-21 continue]
tmp:look=autostrasse & (swisstopo:stadtabstand!=* | swisstopo:stadtabstand>=1500) { delete mkgmap:label:1; name '${swisstopo:shield_autobahn|highway-symbol:box}' | '${tmp:hs_sym}' } [0x10a02 resolution 21-21 continue]
tmp:look=autostrasse { delete mkgmap:label:1; name '${swisstopo:shield_autobahn|highway-symbol:box}' | '${tmp:hs_sym}' } [0x10a02 resolution 22-23]
tmp:look=rampe { name '${destination}' | '${name}' } [0x09 road_class=3 road_speed=4 resolution 24 continue]
tmp:look=rampe { delete mkgmap:label:1 } [0x10a09 resolution 21-23]
tmp:look=durchgang { name '${tmp:hs_sym} ${name}' | '${name}' | '${tmp:hs_sym}' } [0x03 road_class=3 road_speed=5 resolution 24 continue]
tmp:look=durchgang { delete mkgmap:label:1; name '${tmp:hs_sym}' } [0x10a03 resolution 22-23]
tmp:look=verbindung { name '${name}' | '${tmp:hs_sym}' } [0x04 road_class=2 road_speed=4 resolution 24 continue]
tmp:look=verbindung { delete mkgmap:label:1; name '${tmp:hs_sym}' } [0x10a04 resolution 22-23]
tmp:look=w6 { name '${name}' } [0x05 road_class=1 road_speed=3 resolution 24 continue]
tmp:look=w6 & swisstopo:netz_res!=* { delete mkgmap:label:1; name '${tmp:hs_sym}' } [0x10a05 resolution 21-23]
tmp:look=w4 { name '${name}' } [0x06 road_class=0 road_speed=2 resolution 24 continue]
tmp:look=w4 & swisstopo:netz_res!=* { delete mkgmap:label:1 } [0x10a06 resolution 23-23 continue]
tmp:look=w4 & swisstopo:netz_res!=* [0x10b06 resolution 21-22]
tmp:look=w3 { name '${name}' } [0x07 road_class=0 road_speed=1 resolution 24 continue]
tmp:look=w3 & swisstopo:netz_res!=* { delete mkgmap:label:1 } [0x10a07 resolution 23-23 continue]
tmp:look=w3 & swisstopo:netz_res!=* [0x10b07 resolution 22-22]
tmp:look=w2 { name '${name}' } [0x08 road_class=0 road_speed=1 resolution 24 continue]
tmp:look=w2 & swisstopo:netz_res!=* { delete mkgmap:label:1 } [0x10a08 resolution 23-23 continue]
tmp:look=w2 & swisstopo:netz_res!=* [0x10b08 resolution 22-22]
tmp:look=fahrweg { name '${name}' } [0x0a road_class=0 road_speed=1 resolution 24 continue]
tmp:look=fahrweg & swisstopo:netz_res!=* { delete mkgmap:label:1 } [0x10a0a resolution 23-23 continue]
tmp:look=fahrweg & swisstopo:netz_res!=* [0x10b0a resolution 22-22]
tmp:look=weg2 { name '${name}' } [0x0e road_class=0 road_speed=0 resolution 24 continue]
tmp:look=weg2 & swisstopo:netz_res!=* { delete mkgmap:label:1 } [0x10a0e resolution 23-23 continue]
tmp:look=weg2 & swisstopo:netz_res!=* [0x10b0e resolution 22-22]
tmp:look=weg2n { name '${name}' } [0x10 road_class=0 road_speed=0 resolution 24 continue]
tmp:look=weg2n & swisstopo:netz_res!=* { delete mkgmap:label:1 } [0x10a10 resolution 23-23 continue]
tmp:look=weg2n & swisstopo:netz_res!=* [0x10b10 resolution 22-22]
tmp:look=weg1 { name '${name}' } [0x16 road_class=0 road_speed=0 resolution 24 continue]
tmp:look=weg1 & swisstopo:netz_res!=* { delete mkgmap:label:1 } [0x10a16 resolution 23-23 continue]
tmp:look=weg1 & swisstopo:netz_res!=* [0x10b16 resolution 22-22]
tmp:look=spur { name '${name}' } [0x0f road_class=0 road_speed=0 resolution 24 continue]
tmp:look=spur & swisstopo:netz_res!=* { delete mkgmap:label:1 } [0x10a0f resolution 22-23]

# Review 2 (Strassen hängen in der Luft): swisstopo:netz_res von vector-convert = tiefste Auflösung, ab
# der ein Weg gezeichnet wird, so dass das Netz je Stufe zusammenhängt (isolierte Stücke versteckt,
# kurze Anschlüsse hochgestuft). Gilt statt der Klassen-Startstufe; ohne Tag gelten die Regeln oben.
# 19–20: 0x10907 (feine Doppellinie), 21–22: LK50-Typ der Klasse, 23: Übersichtstyp der Klasse.
# Review 2: 3-m-Strassen in 21–22 als Doppellinie wie 4 m (0x10b06), damit sie zwei Stufen früher als
# Strasse lesbar sind (vector-convert: Basis 21 für 3m Strasse mit Hartbelag).
tmp:look=w6 & swisstopo:netz_res=19 { delete mkgmap:label:1 } [0x10907 resolution 19-20 continue]
tmp:look=w6 & swisstopo:netz_res=19 { delete mkgmap:label:1; name '${tmp:hs_sym}' } [0x10a05 resolution 21-23]
tmp:look=w6 & swisstopo:netz_res=20 { delete mkgmap:label:1 } [0x10907 resolution 20-20 continue]
tmp:look=w6 & swisstopo:netz_res=20 { delete mkgmap:label:1; name '${tmp:hs_sym}' } [0x10a05 resolution 21-23]
tmp:look=w6 & swisstopo:netz_res=21 { delete mkgmap:label:1; name '${tmp:hs_sym}' } [0x10a05 resolution 21-23]
tmp:look=w6 & swisstopo:netz_res=22 { delete mkgmap:label:1; name '${tmp:hs_sym}' } [0x10a05 resolution 22-23]
tmp:look=w6 & swisstopo:netz_res=23 { delete mkgmap:label:1; name '${tmp:hs_sym}' } [0x10a05 resolution 23-23]
tmp:look=w4 & swisstopo:netz_res=19 { delete mkgmap:label:1 } [0x10907 resolution 19-20 continue]
tmp:look=w4 & swisstopo:netz_res=19 { delete mkgmap:label:1 } [0x10b06 resolution 21-22 continue]
tmp:look=w4 & swisstopo:netz_res=19 { delete mkgmap:label:1 } [0x10a06 resolution 23-23]
tmp:look=w4 & swisstopo:netz_res=20 { delete mkgmap:label:1 } [0x10907 resolution 20-20 continue]
tmp:look=w4 & swisstopo:netz_res=20 { delete mkgmap:label:1 } [0x10b06 resolution 21-22 continue]
tmp:look=w4 & swisstopo:netz_res=20 { delete mkgmap:label:1 } [0x10a06 resolution 23-23]
